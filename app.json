{
  "expo": {
    "name": "Seodang",
    "slug": "seodang",
    "scheme": "seodang",
    "version": "1.0.1",
    "locales": {
      "ko": "./locales/ko.json",
      "ja": "./locales/ja.json"
    },
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5efe4"
    },
    "ios": {
      "bundleIdentifier": "com.mihye.seodang",
      "icon": {
        "light": "./assets/icon-light.png",
        "dark": "./assets/icon-dark.png"
      },
      "supportsTablet": true,
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "학습 알림을 보내기 위해 알림 권한이 필요합니다.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mihye.seodang",
      "newArchEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-android.png",
        "backgroundColor": "#10281c"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#c4473a"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a15f3174-b503-4d50-b6e2-d1704bd67b40"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a15f3174-b503-4d50-b6e2-d1704bd67b40"
    }
  }
}
