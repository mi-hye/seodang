  "specs": [
    {
      "id": 12604429,
      "name": "01 · 매일 실제로 학습한 기기",
      "description": "수업에서 다음 단계로 진행한 기기를 하루에 한 번 셉니다. 앱을 열기만 한 경우는 제외합니다. 선이 꾸준히 올라가는지 보세요. 동일한 사람이 여러 기기를 쓰면 각각 집계됩니다.",
      "query": {
        "kind": "TrendsQuery",
        "dateRange": {
          "date_from": "-28d"
        },
        "properties": [
          {
            "key": "client",
            "type": "event",
            "value": [
              "seodang-capacitor"
            ],
            "operator": "exact"
          },
          {
            "key": "environment",
            "type": "event",
            "value": [
              "production"
            ],
            "operator": "exact"
          }
        ],
        "filterTestAccounts": false,
        "interval": "day",
        "series": [
          {
            "kind": "EventsNode",
            "event": "learning_progress",
            "math": "dau",
            "custom_name": "학습 진행"
          }
        ],
        "trendsFilter": {
          "display": "ActionsLineGraph"
        }
      }
    },
    {
      "id": 12604430,
      "name": "04 · 참여한 뒤 첫 수업까지 마쳤나요?",
      "description": "통계 참여 → 수업 시작 → 수업 완료에 7일 안에 도달한 비율입니다. 기존 사용자도 첫 동의 때 들어오므로 신규 설치 전환율은 아닙니다. 어느 단계에서 줄어드는지 보고 개선할 화면을 정하세요. 마지막 7일은 아직 진행 중입니다.",
      "query": {
        "kind": "FunnelsQuery",
        "dateRange": {
          "date_from": "-28d"
        },
        "properties": [
          {
            "key": "client",
            "type": "event",
            "value": [
              "seodang-capacitor"
            ],
            "operator": "exact"
          },
          {
            "key": "environment",
            "type": "event",
            "value": [
              "production"
            ],
            "operator": "exact"
          }
        ],
        "filterTestAccounts": false,
        "series": [
          {
            "kind": "EventsNode",
            "event": "analytics_enabled",
            "custom_name": "통계 참여"
          },
          {
            "kind": "EventsNode",
            "event": "lesson_started",
            "custom_name": "수업 시작"
          },
          {
            "kind": "EventsNode",
            "event": "lesson_completed",
            "custom_name": "수업 완료"
          }
        ],
        "funnelsFilter": {
          "funnelOrderType": "ordered",
          "funnelVizType": "steps",
          "funnelStepReference": "total",
          "funnelWindowInterval": 7,
          "funnelWindowIntervalUnit": "day",
          "layout": "vertical"
        }
      }
    },
    {
      "id": 12604431,
      "name": "05 · 다음 날·7일 뒤에도 공부하나요?",
      "description": "첫 관측 학습 후 정확히 다음 날(Day 1)·7일 뒤(Day 7) 다시 학습한 비율입니다. 한국 날짜 기준입니다. 아직 날짜가 지나지 않은 칸과 표본이 적은 날은 판단을 미뤄 주세요. 전체 설치자가 아닌 통계 참여 기기 기준입니다.",
      "query": {
        "kind": "RetentionQuery",
        "dateRange": {
          "date_from": "-28d"
        },
        "properties": [
          {
            "key": "client",
            "type": "event",
            "value": [
              "seodang-capacitor"
            ],
            "operator": "exact"
          },
          {
            "key": "environment",
            "type": "event",
            "value": [
              "production"
            ],
            "operator": "exact"
          }
        ],
        "filterTestAccounts": false,
        "retentionFilter": {
          "targetEntity": {
            "id": "learning_progress",
            "type": "events"
          },
          "returningEntity": {
            "id": "learning_progress",
            "type": "events"
          },
          "period": "Day",
          "retentionType": "retention_first_time",
          "timeWindowMode": "strict_calendar_dates",
          "totalIntervals": 8,
          "cumulative": false,
          "retentionReference": "total",
          "meanRetentionCalculation": "weighted",
          "aggregationType": "count"
        }
      }
    },
    {
